<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('../partials/nav-public') %>

  <div class="max-w-7xl mx-auto px-4 py-8 sm:py-12">
    <%- include('../partials/flash') %>

    <!-- Hero Section -->
    <div class="text-center mb-10 sm:mb-14">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-primary-500 rounded-2xl mb-5 shadow-lg">
        <span class="material-icons-round text-white" style="font-size:32px;">checkroom</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 dark:text-white mb-3">Welcome to <span class="text-primary-500">Tailor Flow</span></h1>
      <p class="text-base sm:text-lg text-gray-500 dark:text-gray-400 max-w-xl mx-auto">Get your clothes custom-fitted to perfection. Track your orders in real-time.</p>
    </div>

    <!-- Track Order Card -->
    <div class="card max-w-lg mx-auto mb-10">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-10 h-10 bg-primary-50 dark:bg-primary-500/10 rounded-xl flex items-center justify-center">
          <span class="material-icons-round text-primary-500">local_shipping</span>
        </div>
        <h2 class="text-xl font-bold text-gray-800 dark:text-white">Track Your Order</h2>
      </div>
      <form action="/track" method="POST" class="space-y-4">
        <div>
          <label class="form-label">Mobile Number</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">phone</span>
            <input type="text" name="phone" placeholder="Enter your 10-15 digit number" class="form-input pl-10" required pattern="[0-9]{10,15}" />
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg">
          <span class="material-icons-round mi-sm">search</span>
          Track Order
        </button>
      </form>
    </div>

    <!-- Order Results -->
    <% if (typeof trackResults !== 'undefined' && trackResults) { %>
      <div class="max-w-3xl mx-auto mb-10">
        <!-- Customer Info -->
        <div class="card mb-4">
          <div class="flex items-center gap-3 mb-1">
            <div class="w-10 h-10 bg-primary-100 dark:bg-primary-500/20 rounded-full flex items-center justify-center">
              <span class="material-icons-round text-primary-500">person</span>
            </div>
            <div>
              <h3 class="text-lg font-bold text-gray-800 dark:text-white"><%= trackResults.customer.name %></h3>
              <p class="text-sm text-gray-500 dark:text-gray-400"><%= trackResults.orders.length %> active order<%= trackResults.orders.length !== 1 ? 's' : '' %></p>
            </div>
          </div>
        </div>

        <!-- Shop Info -->
        <% if (trackResults.orders.length > 0 && trackResults.orders[0].shop) { %>
          <div class="card mb-4 border-l-4 border-l-primary-500">
            <div class="flex items-center gap-2 mb-2">
              <span class="material-icons-round mi-sm text-primary-500">store</span>
              <span class="text-sm font-semibold text-gray-700 dark:text-gray-300">Shop Information</span>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400"><strong><%= trackResults.orders[0].shop.shopName %></strong></p>
            <% if (trackResults.orders[0].shop.address) { %>
              <p class="text-xs text-gray-500 dark:text-gray-500 mt-1"><span class="material-icons-round mi-sm align-middle">location_on</span> <%= trackResults.orders[0].shop.address %></p>
            <% } %>
            <% if (trackResults.orders[0].shop.phone) { %>
              <p class="text-xs text-gray-500 dark:text-gray-500 mt-1"><span class="material-icons-round mi-sm align-middle">call</span> <%= trackResults.orders[0].shop.phone %></p>
            <% } %>
          </div>
        <% } %>

        <!-- Orders -->
        <% trackResults.orders.forEach((order, idx) => { %>
          <div class="card mb-4 <%= order.status === 'Ready for Pickup' ? 'border-2 border-success-500' : '' %>">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-5">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-gray-100 dark:bg-gray-800 rounded-xl flex items-center justify-center">
                  <span class="material-icons-round text-gray-600 dark:text-gray-400">checkroom</span>
                </div>
                <div>
                  <h4 class="font-bold text-gray-800 dark:text-white">Order #<%= order.orderNumber %></h4>
                  <p class="text-xs text-gray-500 dark:text-gray-400"><%= order.garmentType %></p>
                </div>
              </div>
              <span class="badge
                <%= order.status === 'Order Placed' ? 'badge-placed' : '' %>
                <%= order.status === 'Cutting' ? 'badge-cutting' : '' %>
                <%= order.status === 'In Stitching' ? 'badge-stitching' : '' %>
                <%= order.status === 'Final Touches' ? 'badge-touches' : '' %>
                <%= order.status === 'Ready for Pickup' ? 'badge-ready' : '' %>
              "><%= order.status %></span>
            </div>

            <!-- Status Stepper -->
            <%
              const statuses = ['Order Placed', 'Cutting', 'In Stitching', 'Final Touches', 'Ready for Pickup'];
              const currentIndex = statuses.indexOf(order.status);
            %>
            <div class="stepper mb-5">
              <% statuses.forEach((step, i) => { %>
                <div class="step <%= i < currentIndex ? 'completed' : '' %> <%= i === currentIndex ? 'active' : '' %>">
                  <div class="step-circle">
                    <% if (i < currentIndex) { %>
                      <span class="material-icons-round" style="font-size:16px;">check</span>
                    <% } else { %>
                      <%= i + 1 %>
                    <% } %>
                  </div>
                  <div class="step-label"><%= step %></div>
                  <% if (i < statuses.length - 1) { %>
                    <div class="step-line"></div>
                  <% } %>
                </div>
              <% }) %>
            </div>

            <% if (order.status === 'Ready for Pickup') { %>
              <div class="bg-success-50 dark:bg-green-900/30 rounded-lg p-4 mb-4 flex items-center gap-3">
                <span class="material-icons-round text-success-600" style="font-size:28px;">check_circle</span>
                <div>
                  <p class="font-semibold text-success-700 dark:text-green-300">Ready for Pickup!</p>
                  <p class="text-xs text-success-600 dark:text-green-400">Your order is ready. Please visit the shop to collect.</p>
                </div>
              </div>
            <% } %>

            <!-- Ready Photo -->
            <% if (order.readyPhotoUrl) { %>
              <div class="mb-4">
                <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 mb-2 uppercase">Ready Photo</p>
                <img src="<%= order.readyPhotoUrl %>" alt="Ready order photo" class="rounded-lg max-h-48 object-cover border border-gray-200 dark:border-gray-700" />
              </div>
            <% } %>

            <div class="grid grid-cols-2 gap-3 text-sm">
              <div>
                <p class="text-xs text-gray-400 dark:text-gray-500 uppercase font-medium">Created</p>
                <p class="font-semibold text-gray-700 dark:text-gray-300"><%= new Date(order.createdAt).toLocaleDateString() %></p>
              </div>
              <div>
                <p class="text-xs text-gray-400 dark:text-gray-500 uppercase font-medium">Due Date</p>
                <p class="font-semibold text-gray-700 dark:text-gray-300"><%= order.dueDate ? new Date(order.dueDate).toLocaleDateString() : 'Not set' %></p>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (typeof trackError !== 'undefined' && trackError) { %>
      <div class="max-w-lg mx-auto mb-10">
        <div class="card border-l-4 border-l-accent-400">
          <div class="flex items-center gap-3">
            <span class="material-icons-round text-accent-500">info</span>
            <p class="text-sm text-gray-600 dark:text-gray-400"><%= trackError %></p>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Features Section -->
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-gray-800 dark:text-white text-center mb-8">Why Choose Us</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="card text-center">
          <div class="w-12 h-12 bg-primary-50 dark:bg-primary-500/10 rounded-xl flex items-center justify-center mx-auto mb-3">
            <span class="material-icons-round text-primary-500">precision_manufacturing</span>
          </div>
          <h3 class="font-bold text-gray-800 dark:text-white mb-1">Perfect Fit</h3>
          <p class="text-sm text-gray-500 dark:text-gray-400">Custom measurements for every garment</p>
        </div>
        <div class="card text-center">
          <div class="w-12 h-12 bg-accent-50 dark:bg-accent-500/10 rounded-xl flex items-center justify-center mx-auto mb-3">
            <span class="material-icons-round text-accent-500">track_changes</span>
          </div>
          <h3 class="font-bold text-gray-800 dark:text-white mb-1">Real-time Tracking</h3>
          <p class="text-sm text-gray-500 dark:text-gray-400">Track your order status anytime</p>
        </div>
        <div class="card text-center">
          <div class="w-12 h-12 bg-success-50 dark:bg-success-500/10 rounded-xl flex items-center justify-center mx-auto mb-3">
            <span class="material-icons-round text-success-600">verified</span>
          </div>
          <h3 class="font-bold text-gray-800 dark:text-white mb-1">Quality Assured</h3>
          <p class="text-sm text-gray-500 dark:text-gray-400">Expert tailoring with quality checks</p>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
