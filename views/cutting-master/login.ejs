<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <div class="card shadow-elevated">
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-amber-500 rounded-2xl mb-4 shadow-lg">
          <span class="material-icons-round text-white" style="font-size:32px;">carpenter</span>
        </div>
        <h1 class="text-2xl font-extrabold text-gray-800 dark:text-white">Cutting Master</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Login to manage cutting orders</p>
      </div>

      <%- include('../partials/flash') %>

      <form action="/cutting-master/login" method="POST" class="space-y-5">
        <div>
          <label class="form-label">Shop Code</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">store</span>
            <input type="text" name="shopCode" placeholder="e.g., ROY12345" class="form-input pl-10 uppercase" required style="text-transform:uppercase;" />
          </div>
        </div>
        <div>
          <label class="form-label">Username</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">person</span>
            <input type="text" name="username" placeholder="Enter your username" class="form-input pl-10" required autocomplete="username" />
          </div>
        </div>
        <div>
          <label class="form-label">Password</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">lock</span>
            <input type="password" name="password" placeholder="Enter your password" class="form-input pl-10" required autocomplete="current-password" />
          </div>
        </div>
        <button type="submit" class="btn btn-block btn-lg mt-2" style="background:#F57C00;color:white;">
          <span class="material-icons-round mi-sm">login</span>Login
        </button>
      </form>

      <div class="mt-6 pt-5 border-t border-gray-100 dark:border-gray-800 text-center">
        <a href="/" class="text-sm text-primary-500 hover:text-primary-600 dark:text-primary-400 font-medium inline-flex items-center gap-1">
          <span class="material-icons-round mi-sm">arrow_back</span>Back to Home
        </a>
      </div>

      <p class="text-center text-xs text-gray-400 dark:text-gray-600 mt-4">Contact your admin to get login credentials</p>
    </div>
  </div>
</body>
</html>
