<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <div class="card shadow-elevated">
      <!-- Header -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-primary-500 rounded-2xl mb-4 shadow-lg">
          <span class="material-icons-round text-white" style="font-size:32px;">admin_panel_settings</span>
        </div>
        <h1 class="text-2xl font-extrabold text-gray-800 dark:text-white">Admin Login</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Tailor Management System</p>
      </div>

      <%- include('../partials/flash') %>

      <form action="/admin/login" method="POST" class="space-y-5">
        <div>
          <label class="form-label">Shop Code</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">store</span>
            <input type="text" name="shopCode" placeholder="e.g., ROY12345" class="form-input pl-10 uppercase" required style="text-transform:uppercase;" />
          </div>
          <p class="text-xs text-gray-400 mt-1">Get this from your shop admin</p>
        </div>

        <div>
          <label class="form-label">Username</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">person</span>
            <input type="text" name="username" placeholder="Enter username" class="form-input pl-10" required autocomplete="username" />
          </div>
        </div>

        <div>
          <label class="form-label">Password</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">lock</span>
            <input type="password" name="password" placeholder="Enter password" class="form-input pl-10" required autocomplete="current-password" />
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg mt-2">
          <span class="material-icons-round mi-sm">login</span>
          Login
        </button>
      </form>

      <div class="mt-6 pt-5 border-t border-gray-100 dark:border-gray-800 text-center space-y-2">
        <a href="/register" class="text-sm text-primary-500 hover:text-primary-600 dark:text-primary-400 font-medium inline-flex items-center gap-1">
          <span class="material-icons-round mi-sm">app_registration</span>Don't have a shop? Register
        </a>
        <br>
        <a href="/" class="text-sm text-gray-400 hover:text-gray-600 font-medium inline-flex items-center gap-1">
          <span class="material-icons-round mi-sm">arrow_back</span>Back to Home
        </a>
      </div>
    </div>
  </div>
</body>
</html>
