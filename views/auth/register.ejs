<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <div class="card shadow-elevated">
      <!-- Header -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-primary-500 rounded-2xl mb-4 shadow-lg">
          <span class="material-icons-round text-white" style="font-size:32px;">store</span>
        </div>
        <h1 class="text-2xl font-extrabold text-gray-800 dark:text-white">Register Your Shop</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Create your shop and admin account</p>
      </div>

      <%- include('../partials/flash') %>

      <form action="/register" method="POST" class="space-y-5">
        <div class="border-b border-gray-100 dark:border-gray-800 pb-4 mb-4">
          <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Shop Details</p>
          <div class="space-y-4">
            <div>
              <label class="form-label">Shop Name *</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">store</span>
                <input type="text" name="shopName" placeholder="e.g., Royal Tailors" class="form-input pl-10" required />
              </div>
            </div>
            <div>
              <label class="form-label">Phone</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">phone</span>
                <input type="text" name="phone" placeholder="e.g., 03001234567" class="form-input pl-10" />
              </div>
            </div>
            <div>
              <label class="form-label">Address</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">location_on</span>
                <input type="text" name="address" placeholder="Shop address" class="form-input pl-10" />
              </div>
            </div>
          </div>
        </div>

        <div>
          <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Admin Account</p>
          <div class="space-y-4">
            <div>
              <label class="form-label">Admin Username *</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">person</span>
                <input type="text" name="adminUsername" placeholder="e.g., admin" class="form-input pl-10" required minlength="3" />
              </div>
            </div>
            <div>
              <label class="form-label">Password *</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">lock</span>
                <input type="password" name="adminPassword" placeholder="At least 6 characters" class="form-input pl-10" required minlength="6" />
              </div>
            </div>
            <div>
              <label class="form-label">Confirm Password *</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">lock</span>
                <input type="password" name="confirmPassword" placeholder="Re-enter password" class="form-input pl-10" required minlength="6" />
              </div>
            </div>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg mt-2">
          <span class="material-icons-round mi-sm">app_registration</span>
          Register Shop
        </button>
      </form>

      <div class="mt-6 pt-5 border-t border-gray-100 dark:border-gray-800 text-center space-y-2">
        <a href="/admin/login" class="text-sm text-primary-500 hover:text-primary-600 dark:text-primary-400 font-medium inline-flex items-center gap-1">
          <span class="material-icons-round mi-sm">login</span>Already have a shop? Login
        </a>
        <br>
        <a href="/" class="text-sm text-gray-400 hover:text-gray-600 font-medium inline-flex items-center gap-1">
          <span class="material-icons-round mi-sm">arrow_back</span>Back to Home
        </a>
      </div>
    </div>
  </div>
</body>
</html>
