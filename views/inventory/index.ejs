<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('../partials/nav-admin') %>

  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8">
    <%- include('../partials/flash') %>

    <div class="flex items-center gap-3 mb-6">
      <span class="material-icons-round text-primary-500 mi-xl">inventory_2</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-800 dark:text-white">Inventory</h1>
    </div>

    <% if (items && items.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <% items.forEach((item) => { %>
          <div class="card hover:shadow-card-hover">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-bold text-gray-800 dark:text-white"><%= item.itemName %></h3>
              <span class="badge badge-stitching"><%= item.unit %></span>
            </div>

            <% if (item.quantity <= item.lowStockThreshold) { %>
              <div class="bg-danger-50 dark:bg-red-900/20 border border-danger-200 dark:border-red-800 rounded-lg px-3 py-2 mb-4 flex items-center gap-2">
                <span class="material-icons-round mi-sm text-danger-500">warning</span>
                <span class="text-xs font-semibold text-danger-600 dark:text-red-300">Low Stock Alert!</span>
              </div>
            <% } %>

            <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-5 mb-5 text-center">
              <p class="text-xs text-gray-400 uppercase font-medium mb-1">Current Stock</p>
              <p class="text-4xl font-extrabold <%= item.quantity <= item.lowStockThreshold ? 'text-danger-500' : 'text-primary-500' %>">
                <%= item.quantity %>
              </p>
              <p class="text-xs text-gray-400 mt-1">Threshold: <%= item.lowStockThreshold %></p>
            </div>

            <div class="space-y-2">
              <form action="/admin/inventory/<%= item._id %>/increment" method="POST">
                <div class="flex gap-2">
                  <input type="number" name="amount" value="1" min="1" class="form-input text-center flex-1 text-sm" />
                  <button type="submit" class="btn btn-success" style="min-width:48px;">
                    <span class="material-icons-round mi-sm">add</span>
                  </button>
                </div>
              </form>
              <form action="/admin/inventory/<%= item._id %>/decrement" method="POST">
                <div class="flex gap-2">
                  <input type="number" name="amount" value="1" min="1" class="form-input text-center flex-1 text-sm" />
                  <button type="submit" class="btn btn-danger" style="min-width:48px;">
                    <span class="material-icons-round mi-sm">remove</span>
                  </button>
                </div>
              </form>
            </div>

            <p class="text-xs text-gray-400 mt-4 pt-3 border-t border-gray-100 dark:border-gray-800">
              Updated: <%= new Date(item.updatedAt).toLocaleDateString() %>
            </p>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="card text-center py-12">
        <span class="material-icons-round text-gray-300 dark:text-gray-600" style="font-size:64px;">inventory_2</span>
        <p class="text-gray-400 mt-3 text-lg">No inventory items found.</p>
      </div>
    <% } %>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
