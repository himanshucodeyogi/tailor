<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('./partials/nav-public') %>

  <div class="max-w-lg mx-auto px-4 py-20 text-center">
    <div class="w-24 h-24 bg-danger-50 dark:bg-red-500/10 rounded-full flex items-center justify-center mx-auto mb-6">
      <span class="material-icons-round text-danger-500" style="font-size:48px;">error_outline</span>
    </div>
    <h1 class="text-7xl font-extrabold text-danger-500 mb-2">500</h1>
    <p class="text-2xl font-bold text-gray-800 dark:text-white mb-3">Server Error</p>
    <p class="text-gray-500 dark:text-gray-400 mb-6">Something went wrong on our end. Please try again later.</p>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="card border-l-4 border-l-danger-500 bg-danger-50 dark:bg-red-900/20 text-left mb-6">
        <p class="text-sm font-mono text-danger-600 dark:text-red-300 break-all"><%= error %></p>
      </div>
    <% } %>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/" class="btn btn-primary btn-lg">
        <span class="material-icons-round mi-sm">home</span>Go Home
      </a>
      <button onclick="location.reload()" class="btn btn-outline btn-lg">
        <span class="material-icons-round mi-sm">refresh</span>Retry
      </button>
    </div>
  </div>

  <%- include('./partials/footer') %>
</body>
</html>
