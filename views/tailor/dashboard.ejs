<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('../partials/nav-tailor') %>

  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8">
    <%- include('../partials/flash') %>

    <!-- Stats -->
    <div class="grid grid-cols-3 gap-3 sm:gap-5 mb-6 sm:mb-8">
      <div class="stat-card" style="border-color: #FFA726;">
        <div class="stat-icon" style="background: #FFA726;"><span class="material-icons-round">receipt_long</span></div>
        <div><div class="stat-value text-accent-400"><%= stats.totalOrders %></div><div class="stat-label">Total</div></div>
      </div>
      <div class="stat-card" style="border-color: #1976D2;">
        <div class="stat-icon" style="background: #1976D2;"><span class="material-icons-round">pending</span></div>
        <div><div class="stat-value text-primary-500"><%= stats.inProgress %></div><div class="stat-label">In Progress</div></div>
      </div>
      <div class="stat-card" style="border-color: #388E3C;">
        <div class="stat-icon" style="background: #388E3C;"><span class="material-icons-round">check_circle</span></div>
        <div><div class="stat-value text-success-600"><%= stats.readyForPickup %></div><div class="stat-label">Ready</div></div>
      </div>
    </div>

    <!-- Active Orders -->
    <div class="card">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
        <div class="flex items-center gap-2">
          <span class="material-icons-round text-accent-500">receipt_long</span>
          <h2 class="text-lg font-bold text-gray-800 dark:text-white">My Orders</h2>
        </div>
        <div class="relative">
          <span class="material-icons-round mi-sm absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">search</span>
          <input type="text" id="orderSearch" placeholder="Search by order #" class="input pl-10 py-2 text-sm w-full sm:w-48" oninput="filterOrders(this.value)">
        </div>
      </div>

      <% if (orders.length === 0) { %>
        <div class="text-center py-10">
          <span class="material-icons-round text-gray-300 dark:text-gray-600" style="font-size:48px;">receipt_long</span>
          <p class="text-gray-400 mt-2">No active orders</p>
        </div>
      <% } else { %>
        <!-- Desktop -->
        <div class="hidden sm:block overflow-x-auto">
          <table class="data-table">
            <thead><tr><th>Order #</th><th>Customer</th><th>Garment</th><th>Status</th><th>Due Date</th><th>Action</th></tr></thead>
            <tbody>
              <% orders.forEach((order) => { %>
                <tr>
                  <td class="font-mono font-bold"><%= order.orderNumber %></td>
                  <td><div><p class="font-medium text-gray-800 dark:text-white"><%= order.customer.name %></p><p class="text-xs text-gray-400"><%= order.customer.phone %></p></div></td>
                  <td><%= order.garmentType %></td>
                  <td><span class="badge <%= order.status === 'Order Placed' ? 'badge-placed' : '' %><%= order.status === 'Cutting' ? 'badge-cutting' : '' %><%= order.status === 'In Stitching' ? 'badge-stitching' : '' %><%= order.status === 'Final Touches' ? 'badge-touches' : '' %><%= order.status === 'Ready for Pickup' ? 'badge-ready' : '' %>"><%= order.status %></span></td>
                  <td class="text-sm"><%= order.dueDate ? new Date(order.dueDate).toLocaleDateString() : 'Not set' %></td>
                  <td><a href="/tailor/orders/<%= order._id %>" class="btn btn-accent btn-sm">View</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <!-- Mobile -->
        <div class="sm:hidden space-y-3">
          <% orders.forEach((order) => { %>
            <a href="/tailor/orders/<%= order._id %>" class="order-card-mobile block bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-lg p-4" data-ordernum="<%= order.orderNumber %>"
              <div class="flex justify-between items-start mb-2">
                <div>
                  <p class="font-mono font-bold text-sm text-gray-800 dark:text-white">#<%= order.orderNumber %></p>
                  <p class="text-xs text-gray-500"><%= order.customer.name %></p>
                </div>
                <span class="badge <%= order.status === 'Order Placed' ? 'badge-placed' : '' %><%= order.status === 'Cutting' ? 'badge-cutting' : '' %><%= order.status === 'In Stitching' ? 'badge-stitching' : '' %><%= order.status === 'Final Touches' ? 'badge-touches' : '' %><%= order.status === 'Ready for Pickup' ? 'badge-ready' : '' %>"><%= order.status %></span>
              </div>
              <div class="flex justify-between text-xs text-gray-500">
                <span><%= order.garmentType %></span>
                <span><%= order.dueDate ? new Date(order.dueDate).toLocaleDateString() : 'No due date' %></span>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    function filterOrders(query) {
      query = query.toLowerCase().trim();
      document.querySelectorAll('.data-table tbody tr').forEach(row => {
        const orderNum = row.querySelector('td')?.textContent.toLowerCase() || '';
        row.style.display = orderNum.includes(query) ? '' : 'none';
      });
      document.querySelectorAll('.order-card-mobile').forEach(card => {
        const orderNum = card.dataset.ordernum?.toLowerCase() || '';
        card.style.display = orderNum.includes(query) ? '' : 'none';
      });
    }
  </script>

  <%- include('../partials/footer') %>
</body>
</html>
