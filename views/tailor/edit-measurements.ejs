<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('../partials/nav-tailor') %>

  <div class="max-w-4xl mx-auto px-4 py-6 sm:py-8">
    <%- include('../partials/flash') %>

    <a href="/tailor/dashboard" class="btn btn-ghost btn-sm mb-4">
      <span class="material-icons-round mi-sm">arrow_back</span>Back to Orders
    </a>

    <div class="flex items-center gap-3 mb-6">
      <span class="material-icons-round text-primary-500 mi-xl">straighten</span>
      <div>
        <h1 class="text-2xl font-extrabold text-gray-800 dark:text-white">Edit Measurements</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">Customer: <strong><%= customer.name %></strong></p>
      </div>
    </div>

    <div class="card">
      <form action="/tailor/customers/<%= customer._id %>/measurements?_method=PUT" method="POST" class="space-y-6">
        <div class="flex items-center justify-between">
          <h2 class="font-bold text-gray-800 dark:text-white">Measurement Types</h2>
          <button type="button" onclick="addMeasurementType()" class="btn btn-success btn-sm">
            <span class="material-icons-round mi-sm">add</span>Add Type
          </button>
        </div>

        <div id="measurementTypesContainer" class="space-y-4">
          <% if (customer.measurements && customer.measurements.length > 0) { %>
            <% customer.measurements.forEach((measurement) => { %>
              <div class="measurement-block bg-gray-50 dark:bg-gray-800 p-5 rounded-lg border border-gray-200 dark:border-gray-700" data-type="<%= measurement.type %>">
                <div class="flex justify-between items-center mb-4">
                  <h3 class="font-bold text-accent-500 capitalize flex items-center gap-2">
                    <span class="material-icons-round mi-sm">checkroom</span><%= measurement.type %>
                  </h3>
                  <button type="button" onclick="this.closest('.measurement-block').remove()" class="btn btn-danger btn-sm">
                    <span class="material-icons-round mi-sm">close</span>
                  </button>
                </div>
                <input type="hidden" name="measurementTypes" value="<%= measurement.type %>">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                  <% ['length', 'chest', 'shoulder', 'waist', 'arm', 'neck', 'hip', 'thigh'].forEach((field) => { %>
                    <div>
                      <label class="form-label text-xs"><%= field.charAt(0).toUpperCase() + field.slice(1) %> (cm)</label>
                      <input type="number" name="<%= field %>_<%= measurement.type %>" value="<%= measurement[field] || '' %>" step="0.1" min="0" class="form-input text-sm" />
                    </div>
                  <% }) %>
                </div>
                <div class="mt-3">
                  <label class="form-label text-xs">Notes</label>
                  <textarea name="notes_<%= measurement.type %>" rows="2" class="form-input text-sm"><%= measurement.notes || '' %></textarea>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-100 dark:border-gray-800">
          <button type="submit" class="btn btn-primary btn-lg flex-1 sm:flex-none">
            <span class="material-icons-round mi-sm">save</span>Save Measurements
          </button>
          <a href="/tailor/dashboard" class="btn btn-outline btn-lg flex-1 sm:flex-none text-center">Cancel</a>
        </div>
      </form>
    </div>
  </div>

  <script>
    const measurementTypes = ['pant', 'shirt', 'coat', 'jacket', 'kurta', 'salwar', 'sherwani', 'lehenga', 'saree', 'other'];
    function getUsedTypes() {
      return Array.from(document.querySelectorAll('.measurement-block')).map(b => b.getAttribute('data-type'));
    }
    function addMeasurementType() {
      const used = getUsedTypes();
      const available = measurementTypes.filter(t => !used.includes(t));
      if (available.length === 0) { alert('All measurement types added'); return; }
      const type = available[0];
      const container = document.getElementById('measurementTypesContainer');
      const fields = ['length', 'chest', 'shoulder', 'waist', 'arm', 'neck', 'hip', 'thigh'];
      const fieldsHtml = fields.map(f => `<div><label class="form-label text-xs">${f.charAt(0).toUpperCase() + f.slice(1)} (cm)</label><input type="number" name="${f}_${type}" step="0.1" min="0" class="form-input text-sm" /></div>`).join('');
      const block = document.createElement('div');
      block.className = 'measurement-block bg-gray-50 dark:bg-gray-800 p-5 rounded-lg border border-gray-200 dark:border-gray-700';
      block.setAttribute('data-type', type);
      block.innerHTML = `
        <div class="flex justify-between items-center mb-4">
          <h3 class="font-bold text-accent-500 capitalize flex items-center gap-2"><span class="material-icons-round mi-sm">checkroom</span>${type}</h3>
          <button type="button" onclick="this.closest('.measurement-block').remove()" class="btn btn-danger btn-sm"><span class="material-icons-round mi-sm">close</span></button>
        </div>
        <input type="hidden" name="measurementTypes" value="${type}">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">${fieldsHtml}</div>
        <div class="mt-3"><label class="form-label text-xs">Notes</label><textarea name="notes_${type}" rows="2" class="form-input text-sm"></textarea></div>`;
      container.appendChild(block);
    }
  </script>

  <%- include('../partials/footer') %>
</body>
</html>
