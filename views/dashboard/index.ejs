<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('../partials/nav-admin') %>

  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8">
    <%- include('../partials/flash') %>

    <div class="flex items-center gap-3 mb-6 sm:mb-8">
      <span class="material-icons-round text-primary-500 mi-xl">dashboard</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-800 dark:text-white">Dashboard</h1>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 sm:gap-5 mb-6 sm:mb-8">
      <a href="/admin/customers" class="stat-card" style="border-color: #1976D2;">
        <div class="stat-icon" style="background: #1976D2;"><span class="material-icons-round">people</span></div>
        <div>
          <div class="stat-value text-primary-500"><%= stats.totalCustomers %></div>
          <div class="stat-label">Customers</div>
        </div>
      </a>
      <a href="/admin/orders" class="stat-card" style="border-color: #FFA726;">
        <div class="stat-icon" style="background: #FFA726;"><span class="material-icons-round">receipt_long</span></div>
        <div>
          <div class="stat-value text-accent-400"><%= stats.totalActiveOrders %></div>
          <div class="stat-label">Active Orders</div>
        </div>
      </a>
      <a href="/admin/orders?status=Ready+for+Pickup" class="stat-card" style="border-color: #388E3C;">
        <div class="stat-icon" style="background: #388E3C;"><span class="material-icons-round">check_circle</span></div>
        <div>
          <div class="stat-value text-success-600"><%= stats.readyForPickup %></div>
          <div class="stat-label">Ready</div>
        </div>
      </a>
      <a href="/admin/orders/pending-approvals" class="stat-card" style="border-color: #FF9800;">
        <div class="stat-icon" style="background: #FF9800;"><span class="material-icons-round">pending_actions</span></div>
        <div>
          <div class="stat-value" style="color:#FF9800;"><%= stats.pendingApprovals %></div>
          <div class="stat-label">Pending Approvals</div>
        </div>
      </a>
      <a href="/admin/inventory" class="stat-card" style="border-color: #D32F2F;">
        <div class="stat-icon" style="background: #D32F2F;"><span class="material-icons-round">warning</span></div>
        <div>
          <div class="stat-value text-danger-500"><%= stats.lowStockCount %></div>
          <div class="stat-label">Low Stock</div>
        </div>
      </a>
    </div>

    <!-- Low Stock Alert -->
    <% if (lowStockItems && lowStockItems.length > 0) { %>
      <div class="card mb-6 border-l-4 border-l-danger-500 bg-danger-50 dark:bg-red-900/20">
        <div class="flex items-center gap-2 mb-3">
          <span class="material-icons-round text-danger-500">inventory_2</span>
          <h3 class="font-bold text-danger-600 dark:text-red-300">Low Stock Alert</h3>
        </div>
        <div class="space-y-2">
          <% lowStockItems.forEach((item) => { %>
            <div class="flex justify-between items-center text-sm">
              <span class="text-gray-700 dark:text-gray-300 font-medium"><%= item.itemName %> <span class="text-xs text-gray-400">(<%= item.unit %>)</span></span>
              <span class="text-danger-500 font-bold"><%= item.quantity %> / <%= item.lowStockThreshold %></span>
            </div>
          <% }) %>
        </div>
        <a href="/admin/inventory" class="btn btn-danger btn-sm mt-4">
          <span class="material-icons-round mi-sm">inventory_2</span>Manage Inventory
        </a>
      </div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-6 sm:mb-8">
      <!-- Status Breakdown -->
      <div class="card">
        <div class="flex items-center gap-2 mb-5">
          <span class="material-icons-round text-primary-500">pie_chart</span>
          <h3 class="text-lg font-bold text-gray-800 dark:text-white">Order Status</h3>
        </div>
        <% if (statusBreakdown && statusBreakdown.length > 0) { %>
          <div class="space-y-3">
            <% statusBreakdown.forEach((status) => { %>
              <div class="flex justify-between items-center">
                <span class="badge
                  <%= status._id === 'Order Placed' ? 'badge-placed' : '' %>
                  <%= status._id === 'Cutting' ? 'badge-cutting' : '' %>
                  <%= status._id === 'In Stitching' ? 'badge-stitching' : '' %>
                  <%= status._id === 'Final Touches' ? 'badge-touches' : '' %>
                  <%= status._id === 'Ready for Pickup' ? 'badge-ready' : '' %>
                "><%= status._id %></span>
                <span class="text-lg font-bold text-gray-700 dark:text-gray-300"><%= status.count %></span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-gray-400 dark:text-gray-500 text-sm text-center py-4">No active orders</p>
        <% } %>
      </div>

      <!-- Quick Actions -->
      <div class="card">
        <div class="flex items-center gap-2 mb-5">
          <span class="material-icons-round text-accent-500">bolt</span>
          <h3 class="text-lg font-bold text-gray-800 dark:text-white">Quick Actions</h3>
        </div>
        <div class="space-y-3">
          <a href="/admin/customers/new" class="btn btn-primary btn-block">
            <span class="material-icons-round mi-sm">person_add</span>Add Customer
          </a>
          <a href="/admin/orders/new" class="btn btn-success btn-block">
            <span class="material-icons-round mi-sm">add_circle</span>Create Order
          </a>
          <a href="/admin/orders/pending-approvals" class="btn btn-accent btn-block">
            <span class="material-icons-round mi-sm">pending_actions</span>Pending Approvals
          </a>
          <a href="/admin/orders/bulk-assign" class="btn btn-outline btn-block">
            <span class="material-icons-round mi-sm">assignment_ind</span>Bulk Assign Orders
          </a>
        </div>
      </div>
    </div>

    <!-- Recent Orders -->
    <div class="card">
      <div class="flex items-center justify-between mb-5">
        <div class="flex items-center gap-2">
          <span class="material-icons-round text-primary-500">history</span>
          <h3 class="text-lg font-bold text-gray-800 dark:text-white">Recent Orders</h3>
        </div>
        <a href="/admin/orders" class="btn btn-ghost btn-sm">View All</a>
      </div>

      <!-- Desktop Table -->
      <div class="hidden sm:block overflow-x-auto">
        <table class="data-table">
          <thead>
            <tr>
              <th>Order #</th>
              <th>Customer</th>
              <th>Garment</th>
              <th>Status</th>
              <th>Due Date</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentOrders && recentOrders.length > 0) { %>
              <% recentOrders.forEach((order) => { %>
                <tr>
                  <td class="font-mono font-bold"><%= order.orderNumber %></td>
                  <td><%= order.customer ? order.customer.name : 'N/A' %></td>
                  <td><%= order.garmentType %></td>
                  <td>
                    <span class="badge
                      <%= order.status === 'Order Placed' ? 'badge-placed' : '' %>
                      <%= order.status === 'Cutting' ? 'badge-cutting' : '' %>
                      <%= order.status === 'In Stitching' ? 'badge-stitching' : '' %>
                      <%= order.status === 'Final Touches' ? 'badge-touches' : '' %>
                      <%= order.status === 'Ready for Pickup' ? 'badge-ready' : '' %>
                    "><%= order.status %></span>
                  </td>
                  <td><%= order.dueDate ? new Date(order.dueDate).toLocaleDateString() : '-' %></td>
                  <td><a href="/admin/orders/<%= order._id %>" class="btn btn-ghost btn-sm">View</a></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="6" class="text-center py-8 text-gray-400">No orders yet</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Mobile Cards -->
      <div class="sm:hidden space-y-3">
        <% if (recentOrders && recentOrders.length > 0) { %>
          <% recentOrders.forEach((order) => { %>
            <a href="/admin/orders/<%= order._id %>" class="block bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-lg p-4 hover:shadow-card">
              <div class="flex justify-between items-start gap-2 mb-2">
                <div>
                  <p class="font-mono font-bold text-sm text-gray-800 dark:text-white">#<%= order.orderNumber %></p>
                  <p class="text-xs text-gray-500"><%= order.customer ? order.customer.name : 'N/A' %></p>
                </div>
                <span class="badge
                  <%= order.status === 'Order Placed' ? 'badge-placed' : '' %>
                  <%= order.status === 'Cutting' ? 'badge-cutting' : '' %>
                  <%= order.status === 'In Stitching' ? 'badge-stitching' : '' %>
                  <%= order.status === 'Final Touches' ? 'badge-touches' : '' %>
                  <%= order.status === 'Ready for Pickup' ? 'badge-ready' : '' %>
                "><%= order.status %></span>
              </div>
              <div class="flex justify-between text-xs text-gray-500">
                <span><%= order.garmentType %></span>
                <span><%= order.dueDate ? new Date(order.dueDate).toLocaleDateString() : 'No due date' %></span>
              </div>
            </a>
          <% }) %>
        <% } else { %>
          <p class="text-center text-gray-400 py-6 text-sm">No orders yet</p>
        <% } %>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
