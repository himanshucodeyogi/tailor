<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('../partials/nav-admin') %>

  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8">
    <%- include('../partials/flash') %>

    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-6">
      <div class="flex items-center gap-3">
        <span class="material-icons-round text-primary-500 mi-xl">people</span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-800 dark:text-white">Customers</h1>
      </div>
      <a href="/admin/customers/new" class="btn btn-primary w-full sm:w-auto">
        <span class="material-icons-round mi-sm">person_add</span>Add Customer
      </a>
    </div>

    <!-- Search -->
    <div class="card mb-6">
      <form action="/admin/customers" method="GET" class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">search</span>
          <input type="text" name="phone" placeholder="Search by phone number..." value="<%= searchPhone %>" class="form-input pl-10" />
        </div>
        <div class="flex gap-2">
          <button type="submit" class="btn btn-primary flex-1 sm:flex-none">Search</button>
          <% if (searchPhone) { %>
            <a href="/admin/customers" class="btn btn-outline flex-1 sm:flex-none">Clear</a>
          <% } %>
        </div>
      </form>
    </div>

    <!-- Desktop Table -->
    <div class="hidden sm:block card p-0 overflow-hidden">
      <table class="data-table">
        <thead>
          <tr>
            <th class="pl-6">Name</th>
            <th>Phone</th>
            <th>Orders</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (customers && customers.length > 0) { %>
            <% customers.forEach((customer) => { %>
              <tr>
                <td class="pl-6">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 bg-primary-50 dark:bg-primary-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                      <span class="material-icons-round mi-sm text-primary-500">person</span>
                    </div>
                    <span class="font-semibold text-gray-800 dark:text-white"><%= customer.name %></span>
                  </div>
                </td>
                <td class="font-mono text-sm"><%= customer.phone %></td>
                <td><span class="badge badge-stitching"><%= customer.orders ? customer.orders.length : 0 %></span></td>
                <td class="text-xs text-gray-500"><%= new Date(customer.createdAt).toLocaleDateString() %></td>
                <td>
                  <div class="flex items-center gap-1">
                    <a href="/admin/customers/<%= customer._id %>" class="btn btn-ghost btn-sm"><span class="material-icons-round mi-sm">visibility</span></a>
                    <a href="/admin/customers/<%= customer._id %>/edit" class="btn btn-ghost btn-sm" style="color:#FFA726;"><span class="material-icons-round mi-sm">edit</span></a>
                    <form action="/admin/customers/<%= customer._id %>?_method=DELETE" method="POST" style="display:inline;" onsubmit="return confirm('Delete this customer and all related orders?');">
                      <button type="submit" class="btn btn-ghost btn-sm" style="color:#D32F2F;"><span class="material-icons-round mi-sm">delete</span></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="5" class="text-center py-10">
              <span class="material-icons-round text-gray-300 dark:text-gray-600" style="font-size:48px;">people_outline</span>
              <p class="text-gray-400 mt-2 text-sm"><%= searchPhone ? 'No customers found matching that phone number.' : 'No customers yet.' %></p>
              <% if (!searchPhone) { %><a href="/admin/customers/new" class="btn btn-primary btn-sm mt-3">Add First Customer</a><% } %>
            </td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Mobile Cards -->
    <div class="sm:hidden space-y-3">
      <% if (customers && customers.length > 0) { %>
        <% customers.forEach((customer) => { %>
          <div class="card">
            <div class="flex justify-between items-start gap-2 mb-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-primary-50 dark:bg-primary-500/10 rounded-full flex items-center justify-center">
                  <span class="material-icons-round text-primary-500">person</span>
                </div>
                <div>
                  <p class="font-semibold text-gray-800 dark:text-white"><%= customer.name %></p>
                  <p class="text-xs text-gray-500 font-mono"><%= customer.phone %></p>
                </div>
              </div>
              <span class="badge badge-stitching"><%= customer.orders ? customer.orders.length : 0 %> orders</span>
            </div>
            <div class="flex gap-2">
              <a href="/admin/customers/<%= customer._id %>" class="btn btn-primary btn-sm flex-1">View</a>
              <a href="/admin/customers/<%= customer._id %>/edit" class="btn btn-accent btn-sm flex-1">Edit</a>
              <form action="/admin/customers/<%= customer._id %>?_method=DELETE" method="POST" style="display:contents;" onsubmit="return confirm('Delete this customer?');">
                <button type="submit" class="btn btn-danger btn-sm flex-1">Delete</button>
              </form>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="card text-center py-8">
          <span class="material-icons-round text-gray-300 dark:text-gray-600" style="font-size:48px;">people_outline</span>
          <p class="text-gray-400 mt-2 text-sm"><%= searchPhone ? 'No customers found.' : 'No customers yet.' %></p>
          <% if (!searchPhone) { %><a href="/admin/customers/new" class="btn btn-primary btn-sm mt-3">Add First Customer</a><% } %>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
