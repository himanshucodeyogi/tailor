<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('../partials/nav-admin') %>

  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8">
    <%- include('../partials/flash') %>

    <a href="/admin/customers" class="btn btn-ghost btn-sm mb-4">
      <span class="material-icons-round mi-sm">arrow_back</span>Back to Customers
    </a>

    <!-- Customer Info -->
    <div class="card mb-6">
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4 mb-5">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 bg-primary-50 dark:bg-primary-500/10 rounded-2xl flex items-center justify-center">
            <span class="material-icons-round text-primary-500" style="font-size:28px;">person</span>
          </div>
          <div>
            <h1 class="text-2xl font-extrabold text-gray-800 dark:text-white"><%= customer.name %></h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 font-mono"><%= customer.phone %></p>
          </div>
        </div>
        <div class="flex gap-2 w-full sm:w-auto">
          <a href="/admin/customers/<%= customer._id %>/edit" class="btn btn-accent flex-1 sm:flex-none">
            <span class="material-icons-round mi-sm">edit</span>Edit
          </a>
          <form action="/admin/customers/<%= customer._id %>?_method=DELETE" method="POST" style="display:flex;flex:1;" onsubmit="return confirm('Delete this customer and all orders?');">
            <button type="submit" class="btn btn-danger flex-1">
              <span class="material-icons-round mi-sm">delete</span>Delete
            </button>
          </form>
        </div>
      </div>

      <% if (customer.notes) { %>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-3 mb-5">
          <p class="text-sm text-gray-600 dark:text-gray-400"><span class="font-semibold">Notes:</span> <%= customer.notes %></p>
        </div>
      <% } %>

      <!-- Measurements -->
      <div class="bg-primary-50 dark:bg-primary-500/5 border border-primary-100 dark:border-primary-500/10 rounded-xl p-4 sm:p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="material-icons-round text-primary-500">straighten</span>
            <h3 class="font-bold text-gray-800 dark:text-white">Measurements (inches)</h3>
          </div>
          <a href="/admin/customers/<%= customer._id %>/edit" class="btn btn-ghost btn-sm">Edit</a>
        </div>

        <% if (customer.measurements && customer.measurements.length > 0) { %>
          <div class="space-y-3">
            <% customer.measurements.forEach((measurement) => { %>
              <%
                const FIELDS_FOR_TYPE = {
                  pant: ['length', 'waist', 'hip', 'thigh', 'knee', 'bottom', 'crotch'],
                  shirt: ['length', 'shoulder', 'chest', 'waist', 'sleeveLength', 'bicep', 'collar', 'cuff'],
                  coat: ['length', 'shoulder', 'chest', 'waist', 'hip', 'sleeveLength', 'armhole', 'crossBack'],
                  sherwani: ['length', 'shoulder', 'chest', 'waist', 'hip', 'sleeveLength', 'armhole', 'crossBack'],
                  jacket: ['length', 'shoulder', 'chest', 'waist', 'sleeve', 'neck'],
                  kurta: ['length', 'shoulder', 'chest', 'waist', 'hip', 'sleeveLength', 'collar', 'slits'],
                  salwar: ['length', 'waist', 'hip', 'crotch', 'bottom'],
                  lehenga: ['skirtLength', 'skirtWaist', 'skirtHip', 'blouseLength', 'blouseChest', 'blouseUnderbust', 'blouseShoulder', 'blouseSleeve'],
                  saree: ['blouseLength', 'blouseChest', 'blouseUnderbust', 'blouseShoulder', 'blouseSleeve', 'petticoatLength', 'petticoatWaist'],
                };
                const FIELD_LABELS = {
                  length: 'Length', shoulder: 'Shoulder', chest: 'Chest', waist: 'Waist', hip: 'Hip', neck: 'Neck',
                  thigh: 'Thigh', knee: 'Knee', bottom: 'Bottom', crotch: 'Crotch',
                  sleeveLength: 'Sleeve Len', bicep: 'Bicep', collar: 'Collar', cuff: 'Cuff',
                  armhole: 'Armhole', crossBack: 'Cross Back', sleeve: 'Sleeve', slits: 'Slits',
                  skirtLength: 'Skirt Len', skirtWaist: 'Skirt Waist', skirtHip: 'Skirt Hip',
                  blouseLength: 'Blouse Len', blouseChest: 'Blouse Chest', blouseUnderbust: 'Blouse Underbust',
                  blouseShoulder: 'Blouse Shoulder', blouseSleeve: 'Blouse Sleeve',
                  petticoatLength: 'Petticoat Len', petticoatWaist: 'Petticoat Waist',
                };
                const displayFields = FIELDS_FOR_TYPE[measurement.type] || Object.keys(FIELD_LABELS);
              %>
              <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4">
                <h4 class="font-bold text-primary-600 dark:text-primary-400 mb-3 capitalize text-sm flex items-center gap-2">
                  <span class="material-icons-round mi-sm">checkroom</span><%= measurement.type %>
                </h4>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                  <% displayFields.forEach((field) => { %>
                    <div>
                      <p class="text-xs text-gray-400 uppercase font-medium"><%= FIELD_LABELS[field] || field %></p>
                      <p class="font-bold text-gray-800 dark:text-white text-sm"><%= measurement[field] || '-' %></p>
                    </div>
                  <% }); %>
                </div>
                <% if (measurement.notes) { %>
                  <p class="text-xs text-gray-500 mt-3 border-t border-gray-100 dark:border-gray-700 pt-2"><span class="font-semibold">Notes:</span> <%= measurement.notes %></p>
                <% } %>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-center py-4">
            <span class="material-icons-round text-gray-300 dark:text-gray-600" style="font-size:40px;">straighten</span>
            <p class="text-gray-400 text-sm mt-2">No measurements added yet.</p>
            <a href="/admin/customers/<%= customer._id %>/edit" class="btn btn-primary btn-sm mt-2">Add Measurements</a>
          </div>
        <% } %>
      </div>

      <div class="flex gap-4 mt-5 text-xs text-gray-400 dark:text-gray-600">
        <span>Created: <%= new Date(customer.createdAt).toLocaleDateString() %></span>
        <span>Updated: <%= new Date(customer.updatedAt).toLocaleDateString() %></span>
      </div>
    </div>

    <!-- Orders -->
    <div class="card">
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-5">
        <div class="flex items-center gap-2">
          <span class="material-icons-round text-accent-500">receipt_long</span>
          <h2 class="text-lg font-bold text-gray-800 dark:text-white">Orders</h2>
        </div>
        <a href="/admin/orders/new?customerId=<%= customer._id %>" class="btn btn-success w-full sm:w-auto">
          <span class="material-icons-round mi-sm">add_circle</span>Create Order
        </a>
      </div>

      <% if (orders && orders.length > 0) { %>
        <!-- Desktop -->
        <div class="hidden sm:block overflow-x-auto">
          <table class="data-table">
            <thead><tr><th>Order #</th><th>Garment</th><th>Status</th><th>Price</th><th>Due Date</th><th>Action</th></tr></thead>
            <tbody>
              <% orders.forEach((order) => { %>
                <tr>
                  <td class="font-mono font-bold"><%= order.orderNumber %></td>
                  <td><%= order.garmentType %></td>
                  <td><span class="badge <%= order.status === 'Order Placed' ? 'badge-placed' : '' %><%= order.status === 'Cutting' ? 'badge-cutting' : '' %><%= order.status === 'In Stitching' ? 'badge-stitching' : '' %><%= order.status === 'Final Touches' ? 'badge-touches' : '' %><%= order.status === 'Ready for Pickup' ? 'badge-ready' : '' %>"><%= order.status %></span></td>
                  <td class="font-semibold">&#8377;<%= order.price %></td>
                  <td class="text-sm"><%= order.dueDate ? new Date(order.dueDate).toLocaleDateString() : '-' %></td>
                  <td><a href="/admin/orders/<%= order._id %>" class="btn btn-ghost btn-sm">View</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <!-- Mobile -->
        <div class="sm:hidden space-y-3">
          <% orders.forEach((order) => { %>
            <a href="/admin/orders/<%= order._id %>" class="block bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-lg p-4">
              <div class="flex justify-between items-start mb-2">
                <div>
                  <p class="font-mono font-bold text-sm">#<%= order.orderNumber %></p>
                  <p class="text-xs text-gray-500"><%= order.garmentType %></p>
                </div>
                <span class="badge <%= order.status === 'Order Placed' ? 'badge-placed' : '' %><%= order.status === 'Cutting' ? 'badge-cutting' : '' %><%= order.status === 'In Stitching' ? 'badge-stitching' : '' %><%= order.status === 'Final Touches' ? 'badge-touches' : '' %><%= order.status === 'Ready for Pickup' ? 'badge-ready' : '' %>"><%= order.status %></span>
              </div>
              <div class="flex justify-between text-xs text-gray-500">
                <span class="font-semibold">&#8377;<%= order.price %></span>
                <span><%= order.dueDate ? new Date(order.dueDate).toLocaleDateString() : 'No due date' %></span>
              </div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-8">
          <span class="material-icons-round text-gray-300 dark:text-gray-600" style="font-size:48px;">receipt_long</span>
          <p class="text-gray-400 text-sm mt-2">No orders yet.</p>
          <a href="/admin/orders/new?customerId=<%= customer._id %>" class="btn btn-success btn-sm mt-3">Create First Order</a>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
