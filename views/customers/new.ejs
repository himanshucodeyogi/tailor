<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('../partials/nav-admin') %>

  <div class="max-w-4xl mx-auto px-4 py-6 sm:py-8">
    <%- include('../partials/flash') %>

    <a href="/admin/customers" class="btn btn-ghost btn-sm mb-4">
      <span class="material-icons-round mi-sm">arrow_back</span>Back to Customers
    </a>

    <div class="flex items-center gap-3 mb-6">
      <span class="material-icons-round text-primary-500 mi-xl">person_add</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-800 dark:text-white">Add New Customer</h1>
    </div>

    <div class="card">
      <form action="/admin/customers" method="POST" class="space-y-6" onsubmit="logFormData(event)">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="form-label">Customer Name *</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">person</span>
              <input type="text" name="name" placeholder="Enter customer name" class="form-input pl-10" required />
            </div>
          </div>
          <div>
            <label class="form-label">Phone Number *</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">phone</span>
              <input type="text" name="phone" placeholder="10-15 digits" class="form-input pl-10" required />
            </div>
          </div>
        </div>

        <div>
          <label class="form-label">Notes</label>
          <textarea name="notes" placeholder="Any special notes about the customer..." rows="3" class="form-input"></textarea>
        </div>

        <!-- Measurements -->
        <div class="bg-primary-50 dark:bg-primary-500/5 border border-primary-100 dark:border-primary-500/10 rounded-xl p-4 sm:p-6">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-4">
            <div class="flex items-center gap-2">
              <span class="material-icons-round text-primary-500">straighten</span>
              <h3 class="font-bold text-gray-800 dark:text-white">Measurements (cm)</h3>
            </div>
            <button type="button" onclick="addMeasurementType()" class="btn btn-success btn-sm w-full sm:w-auto">
              <span class="material-icons-round mi-sm">add</span>Add Measurement
            </button>
          </div>
          <div id="measurementsContainer"></div>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">Click "Add Measurement" to add measurements for different garments</p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-100 dark:border-gray-800">
          <button type="submit" onclick="return validateMeasurements()" class="btn btn-primary btn-lg flex-1 sm:flex-none">
            <span class="material-icons-round mi-sm">save</span>Save Customer
          </button>
          <a href="/admin/customers" class="btn btn-outline btn-lg flex-1 sm:flex-none text-center">Cancel</a>
        </div>
      </form>
    </div>
  </div>

  <%- include('../partials/footer') %>
  <script src="/js/measurements.js"></script>
</body>
</html>
