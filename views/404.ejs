<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('./partials/nav-public') %>

  <div class="max-w-lg mx-auto px-4 py-20 text-center">
    <div class="w-24 h-24 bg-primary-50 dark:bg-primary-500/10 rounded-full flex items-center justify-center mx-auto mb-6">
      <span class="material-icons-round text-primary-500" style="font-size:48px;">search_off</span>
    </div>
    <h1 class="text-7xl font-extrabold text-primary-500 mb-2">404</h1>
    <p class="text-2xl font-bold text-gray-800 dark:text-white mb-3">Page Not Found</p>
    <p class="text-gray-500 dark:text-gray-400 mb-8">Sorry, the page you're looking for doesn't exist or has been moved.</p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/" class="btn btn-primary btn-lg">
        <span class="material-icons-round mi-sm">home</span>Go Home
      </a>
      <button onclick="history.back()" class="btn btn-outline btn-lg">
        <span class="material-icons-round mi-sm">arrow_back</span>Go Back
      </button>
    </div>
  </div>

  <%- include('./partials/footer') %>
</body>
</html>
