<!DOCTYPE html>
<html lang="en">
<%- include('../../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('../../partials/nav-admin') %>

  <div class="max-w-2xl mx-auto px-4 py-6 sm:py-8">
    <%- include('../../partials/flash') %>

    <a href="/admin/cutting-masters" class="btn btn-ghost btn-sm mb-4">
      <span class="material-icons-round mi-sm">arrow_back</span>Back to Cutting Masters
    </a>

    <div class="flex items-center gap-3 mb-6">
      <span class="material-icons-round mi-xl" style="color:#F57C00;">person_add</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-800 dark:text-white">Create Cutting Master</h1>
    </div>

    <div class="card">
      <form action="/admin/cutting-masters" method="POST" class="space-y-5">
        <div>
          <label class="form-label">Full Name *</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">person</span>
            <input type="text" name="name" placeholder="e.g., Raza Khan" class="form-input pl-10" required />
          </div>
        </div>
        <div>
          <label class="form-label">Username *</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">alternate_email</span>
            <input type="text" name="username" placeholder="e.g., cutter_raza" class="form-input pl-10" required minlength="3" />
          </div>
          <p class="text-xs text-gray-400 mt-1">Minimum 3 characters, no spaces</p>
        </div>
        <div>
          <label class="form-label">Password *</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">lock</span>
            <input type="password" name="password" placeholder="At least 6 characters" class="form-input pl-10" required minlength="6" />
          </div>
        </div>
        <div>
          <label class="form-label">Confirm Password *</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">lock</span>
            <input type="password" name="confirmPassword" placeholder="Re-enter password" class="form-input pl-10" required minlength="6" />
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-100 dark:border-gray-800">
          <button type="submit" class="btn btn-primary btn-lg flex-1 sm:flex-none">
            <span class="material-icons-round mi-sm">person_add</span>Create Cutting Master
          </button>
          <a href="/admin/cutting-masters" class="btn btn-outline btn-lg flex-1 sm:flex-none text-center">Cancel</a>
        </div>
      </form>
    </div>
  </div>

  <%- include('../../partials/footer') %>
</body>
</html>
