        <a href="/admin/tailors" class="px-3 py-2 rounded-lg text-sm font-medium <%= typeof request !== 'undefined' && request.path.includes('/tailors') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10 hover:text-white' %>">
          <span class="material-icons-round mi-sm align-middle mr-1">content_cut</span>Tailors
