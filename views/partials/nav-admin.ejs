      </a>
      <a href="/admin/orders" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium <%= typeof request !== 'undefined' && request.path.includes('/orders') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10' %>">
        <span class="material-icons-round mi-sm">receipt_long</span>Orders
      </a>
