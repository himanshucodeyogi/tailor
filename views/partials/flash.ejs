<% if (success && success.length > 0) { %>
  <div class="flex items-center gap-3 bg-success-50 dark:bg-green-900/30 border border-success-200 dark:border-green-800 text-success-700 dark:text-green-300 px-4 py-3 rounded-lg mb-4" role="alert">
    <span class="material-icons-round" style="color: #388E3C;">check_circle</span>
    <span class="text-sm font-medium"><%= success[0] %></span>
  </div>
<% } %>
<% if (error && error.length > 0) { %>
  <div class="flex items-center gap-3 bg-danger-50 dark:bg-red-900/30 border border-danger-200 dark:border-red-800 text-danger-500 dark:text-red-300 px-4 py-3 rounded-lg mb-4" role="alert">
    <span class="material-icons-round" style="color: #D32F2F;">error</span>
    <span class="text-sm font-medium"><%= error[0] %></span>
  </div>
<% } %>
