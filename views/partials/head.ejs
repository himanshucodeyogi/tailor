<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Tailor Flow' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: { 50: '#E3F2FD', 100: '#BBDEFB', 200: '#90CAF9', 300: '#64B5F6', 400: '#42A5F5', 500: '#1976D2', 600: '#1565C0', 700: '#0D47A1', 800: '#0A3A82', 900: '#082E68' },
            accent: { 50: '#FFF3E0', 100: '#FFE0B2', 200: '#FFCC80', 300: '#FFB74D', 400: '#FFA726', 500: '#FF9800', 600: '#FB8C00', 700: '#F57C00', 800: '#EF6C00', 900: '#E65100' },
            success: { 50: '#E8F5E9', 100: '#C8E6C9', 200: '#A5D6A7', 300: '#81C784', 400: '#66BB6A', 500: '#4CAF50', 600: '#388E3C', 700: '#2E7D32', 800: '#1B5E20' },
            danger: { 50: '#FFEBEE', 100: '#FFCDD2', 200: '#EF9A9A', 300: '#E57373', 400: '#EF5350', 500: '#D32F2F', 600: '#C62828', 700: '#B71C1C' },
          },
          fontFamily: {
            sans: ['Inter', 'Segoe UI', 'system-ui', 'sans-serif'],
          },
          boxShadow: {
            'card': '0 2px 8px rgba(0,0,0,0.08)',
            'card-hover': '0 4px 16px rgba(0,0,0,0.12)',
            'elevated': '0 4px 12px rgba(0,0,0,0.1)',
            'nav': '0 2px 12px rgba(0,0,0,0.08)',
          }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
  <script src="/js/theme.js"></script>
  <style>
    /* Material Design inspired base styles */
    body { font-family: 'Inter', 'Segoe UI', system-ui, sans-serif; }

    /* Smooth transitions */
    * { transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; }
    a, button { transition: all 0.2s ease; }

    /* Material icon alignment */
    .material-icons-round { vertical-align: middle; font-size: 20px; }
    .mi-sm { font-size: 16px; }
    .mi-lg { font-size: 24px; }
    .mi-xl { font-size: 32px; }

    /* Card styles */
    .card {
      background: white;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      padding: 1.5rem;
    }
    .dark .card { background: #1E1E1E; }
    .card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.12); }

    /* Material button styles */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.625rem 1.25rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.875rem;
      cursor: pointer;
      border: none;
      text-decoration: none;
    }
    .btn-primary { background: #1976D2; color: white; }
    .btn-primary:hover { background: #1565C0; box-shadow: 0 4px 12px rgba(25,118,210,0.3); }
    .btn-accent { background: #FFA726; color: white; }
    .btn-accent:hover { background: #FF9800; box-shadow: 0 4px 12px rgba(255,167,38,0.3); }
    .btn-success { background: #388E3C; color: white; }
    .btn-success:hover { background: #2E7D32; box-shadow: 0 4px 12px rgba(56,142,60,0.3); }
    .btn-danger { background: #D32F2F; color: white; }
    .btn-danger:hover { background: #C62828; box-shadow: 0 4px 12px rgba(211,47,47,0.3); }
    .btn-outline { background: transparent; border: 2px solid #1976D2; color: #1976D2; }
    .btn-outline:hover { background: #E3F2FD; }
    .btn-ghost { background: transparent; color: #1976D2; }
    .btn-ghost:hover { background: #E3F2FD; }
    .dark .btn-outline { border-color: #64B5F6; color: #64B5F6; }
    .dark .btn-outline:hover { background: rgba(25,118,210,0.15); }
    .dark .btn-ghost { color: #64B5F6; }
    .dark .btn-ghost:hover { background: rgba(25,118,210,0.15); }
    .btn-sm { padding: 0.375rem 0.75rem; font-size: 0.75rem; }
    .btn-lg { padding: 0.75rem 1.5rem; font-size: 1rem; }
    .btn-block { width: 100%; }

    /* Status badges */
    .badge { display: inline-flex; align-items: center; gap: 4px; padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
    .badge-placed { background: #F5F5F5; color: #757575; }
    .badge-cutting { background: #FFF8E1; color: #F57C00; }
    .badge-stitching { background: #E3F2FD; color: #1976D2; }
    .badge-touches { background: #FFF3E0; color: #E65100; }
    .badge-ready { background: #E8F5E9; color: #388E3C; }
    .dark .badge-placed { background: #424242; color: #BDBDBD; }
    .dark .badge-cutting { background: #4E3A00; color: #FFD54F; }
    .dark .badge-stitching { background: #0A3069; color: #64B5F6; }
    .dark .badge-touches { background: #4E2600; color: #FFB74D; }
    .dark .badge-ready { background: #1B3A1B; color: #81C784; }

    /* Status stepper */
    .stepper { display: flex; align-items: flex-start; }
    .step { display: flex; flex-direction: column; align-items: center; flex: 1; position: relative; }
    .step-circle {
      width: 36px; height: 36px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 0.75rem; z-index: 1;
      border: 3px solid #E0E0E0; background: white; color: #9E9E9E;
    }
    .dark .step-circle { background: #2C2C2C; border-color: #555; color: #888; }
    .step.completed .step-circle { background: #388E3C; border-color: #388E3C; color: white; }
    .step.active .step-circle { background: #1976D2; border-color: #1976D2; color: white; animation: pulse-ring 2s infinite; }
    @keyframes pulse-ring { 0% { box-shadow: 0 0 0 0 rgba(25,118,210,0.4); } 70% { box-shadow: 0 0 0 8px rgba(25,118,210,0); } 100% { box-shadow: 0 0 0 0 rgba(25,118,210,0); } }
    .step-label { font-size: 0.65rem; font-weight: 600; margin-top: 6px; text-align: center; color: #9E9E9E; line-height: 1.2; }
    .step.completed .step-label { color: #388E3C; }
    .step.active .step-label { color: #1976D2; }
    .dark .step-label { color: #777; }
    .dark .step.completed .step-label { color: #81C784; }
    .dark .step.active .step-label { color: #64B5F6; }
    .step-line { position: absolute; top: 18px; left: calc(50% + 18px); right: calc(-50% + 18px); height: 3px; background: #E0E0E0; }
    .dark .step-line { background: #444; }
    .step.completed .step-line { background: #388E3C; }
    .step:last-child .step-line { display: none; }

    /* Stat card */
    .stat-card {
      background: white; border-radius: 12px; padding: 1.25rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08); border-left: 4px solid;
      display: flex; align-items: center; gap: 1rem;
    }
    .dark .stat-card { background: #1E1E1E; }
    .stat-card .stat-icon {
      width: 48px; height: 48px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
    }
    .stat-card .stat-icon .material-icons-round { font-size: 24px; color: white; }
    .stat-card .stat-value { font-size: 1.75rem; font-weight: 800; line-height: 1; }
    .stat-card .stat-label { font-size: 0.75rem; font-weight: 500; color: #757575; text-transform: uppercase; letter-spacing: 0.05em; }
    .dark .stat-card .stat-label { color: #999; }

    /* Form inputs */
    .form-input {
      width: 100%; border: 2px solid #E0E0E0; border-radius: 8px;
      padding: 0.75rem 1rem; font-size: 0.875rem; background: white;
      color: #212121;
    }
    .form-input:focus { outline: none; border-color: #1976D2; box-shadow: 0 0 0 3px rgba(25,118,210,0.1); }
    .dark .form-input { background: #2C2C2C; border-color: #444; color: #E0E0E0; }
    .dark .form-input:focus { border-color: #64B5F6; box-shadow: 0 0 0 3px rgba(100,181,246,0.15); }
    .form-label { display: block; font-size: 0.8rem; font-weight: 600; color: #555; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.03em; }
    .dark .form-label { color: #AAA; }

    /* Table styles */
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table th { text-align: left; padding: 0.75rem 1rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #757575; border-bottom: 2px solid #E0E0E0; }
    .data-table td { padding: 0.875rem 1rem; font-size: 0.875rem; border-bottom: 1px solid #F0F0F0; color: #333; }
    .data-table tbody tr:hover { background: #F8FAFC; }
    .dark .data-table th { color: #999; border-color: #444; }
    .dark .data-table td { color: #CCC; border-color: #333; }
    .dark .data-table tbody tr:hover { background: #252525; }

    /* Scrollbar styling */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #94A3B8; }
    .dark ::-webkit-scrollbar-thumb { background: #475569; }

    /* Dialog/Modal */
    .modal-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,0.5);
      display: flex; align-items: center; justify-content: center;
      z-index: 50; opacity: 0; pointer-events: none; transition: opacity 0.2s;
    }
    .modal-overlay.active { opacity: 1; pointer-events: auto; }
    .modal-content { background: white; border-radius: 16px; padding: 1.5rem; max-width: 480px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.2); transform: scale(0.95); transition: transform 0.2s; }
    .modal-overlay.active .modal-content { transform: scale(1); }
    .dark .modal-content { background: #1E1E1E; }

    /* Responsive helpers */
    @media (max-width: 640px) {
      .stat-card { padding: 1rem; gap: 0.75rem; }
      .stat-card .stat-icon { width: 40px; height: 40px; }
      .stat-card .stat-value { font-size: 1.5rem; }
      .card { padding: 1rem; border-radius: 10px; }
      .step-circle { width: 28px; height: 28px; font-size: 0.65rem; }
      .step-line { top: 14px; left: calc(50% + 14px); right: calc(-50% + 14px); }
      .step-label { font-size: 0.55rem; }
    }
  </style>
</head>
