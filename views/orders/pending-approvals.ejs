<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('../partials/nav-admin') %>

  <div class="max-w-6xl mx-auto px-4 py-6 sm:py-8">
    <%- include('../partials/flash') %>

    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-6">
      <div class="flex items-center gap-3">
        <span class="material-icons-round mi-xl" style="color:#FFA726;">pending_actions</span>
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-800 dark:text-white">Pending Approvals</h1>
          <p class="text-sm text-gray-500 dark:text-gray-400">Review ready photos uploaded by tailors</p>
        </div>
      </div>
      <a href="/admin/orders" class="btn btn-outline btn-sm">
        <span class="material-icons-round mi-sm">arrow_back</span>Back to Orders
      </a>
    </div>

    <% if (orders.length === 0) { %>
      <div class="card text-center py-12">
        <span class="material-icons-round text-gray-300 dark:text-gray-600" style="font-size:56px;">check_circle</span>
        <p class="text-gray-400 mt-3 text-lg">No pending approvals</p>
        <p class="text-gray-400 text-sm mt-1">All caught up! Tailors will submit ready photos for your approval.</p>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% orders.forEach((order) => { %>
          <div class="card border-l-4 border-l-accent-400" id="approval-<%= order._id %>">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-bold text-lg text-gray-800 dark:text-white">Order #<%= order.orderNumber %></h3>
                <p class="text-sm text-gray-500"><%= order.customer ? order.customer.name : 'N/A' %> &middot; <%= order.garmentType %></p>
              </div>
              <span class="badge badge-cutting">Pending Review</span>
            </div>

            <% if (order.pendingReadyPhoto) { %>
              <div class="mb-4 rounded-lg overflow-hidden bg-gray-100 dark:bg-gray-800">
                <img src="<%= order.pendingReadyPhoto %>" alt="Ready photo" class="w-full max-h-64 object-contain" />
              </div>
            <% } %>

            <div class="grid grid-cols-2 gap-2 mb-4 text-sm">
              <div><span class="text-gray-400">Status:</span> <span class="font-medium text-gray-700 dark:text-gray-300"><%= order.status %></span></div>
              <div><span class="text-gray-400">Due:</span> <span class="font-medium text-gray-700 dark:text-gray-300"><%= order.dueDate ? new Date(order.dueDate).toLocaleDateString() : 'Not set' %></span></div>
            </div>

            <div class="flex gap-2">
              <button onclick="handleApproval('<%= order._id %>', true)" class="btn btn-success flex-1">
                <span class="material-icons-round mi-sm">check</span>Approve
              </button>
              <button onclick="handleApproval('<%= order._id %>', false)" class="btn btn-danger flex-1">
                <span class="material-icons-round mi-sm">close</span>Reject
              </button>
              <a href="/admin/orders/<%= order._id %>" class="btn btn-outline">
                <span class="material-icons-round mi-sm">visibility</span>
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <script>
    async function handleApproval(orderId, approved) {
      const action = approved ? 'approve' : 'reject';
      if (!confirm(`Are you sure you want to ${action} this order?`)) return;

      try {
        const response = await fetch(`/admin/orders/${orderId}/approve-ready`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ approved }),
        });
        const result = await response.json();
        if (result.success) {
          const card = document.getElementById(`approval-${orderId}`);
          card.style.opacity = '0.5';
          card.style.pointerEvents = 'none';
          card.querySelector('.badge').textContent = approved ? 'Approved' : 'Rejected';
          card.querySelector('.badge').className = `badge ${approved ? 'badge-ready' : 'badge-placed'}`;
        } else {
          alert('Error: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        alert('Failed to process approval');
      }
    }
  </script>

  <%- include('../partials/footer') %>
</body>
</html>
