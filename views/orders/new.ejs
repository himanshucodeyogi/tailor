<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('../partials/nav-admin') %>

  <div class="max-w-4xl mx-auto px-4 py-6 sm:py-8">
    <%- include('../partials/flash') %>

    <a href="/admin/orders" class="btn btn-ghost btn-sm mb-4">
      <span class="material-icons-round mi-sm">arrow_back</span>Back to Orders
    </a>

    <div class="flex items-center gap-3 mb-6">
      <span class="material-icons-round text-success-600 mi-xl">add_circle</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-800 dark:text-white">Create New Order</h1>
    </div>

    <div class="card">
      <form action="/admin/orders" method="POST" class="space-y-6">
        <div>
          <label class="form-label">Customer *</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">person</span>
            <select name="customer" class="form-input pl-10" required>
              <option value="">-- Select a customer --</option>
              <% customers.forEach((customer) => { %>
                <option value="<%= customer._id %>" <%= selectedCustomerId === customer._id.toString() ? 'selected' : '' %>>
                  <%= customer.name %> (<%= customer.phone %>)
                </option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="form-label">Garment Type *</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">checkroom</span>
              <select name="garmentType" class="form-input pl-10" required>
                <option value="Suit">Suit</option>
                <option value="Shirt">Shirt</option>
                <option value="Kurta">Kurta</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>
          <div>
            <label class="form-label">Status</label>
            <select name="status" class="form-input">
              <% statuses.forEach((status) => { %>
                <option value="<%= status %>" <%= status === 'Order Placed' ? 'selected' : '' %>><%= status %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div>
          <label class="form-label">Description</label>
          <textarea name="description" placeholder="Describe the order details..." rows="3" class="form-input"></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="form-label">Price (&#8377;)</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">currency_rupee</span>
              <input type="number" name="price" placeholder="0" step="0.01" min="0" class="form-input pl-10" />
            </div>
          </div>
          <div>
            <label class="form-label">Advance Paid (&#8377;)</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">payments</span>
              <input type="number" name="advancePaid" placeholder="0" step="0.01" min="0" class="form-input pl-10" />
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="form-label">Due Date</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">event</span>
              <input type="date" name="dueDate" class="form-input pl-10" />
            </div>
          </div>
          <div>
            <label class="form-label">Assign Cutting Master</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round mi-sm text-gray-400">carpenter</span>
              <select name="assignedCuttingMaster" class="form-input pl-10">
                <option value="">-- None --</option>
                <% if (typeof cuttingMasters !== 'undefined') { cuttingMasters.forEach((cm) => { %>
                  <option value="<%= cm._id %>"><%= cm.name %></option>
                <% }); } %>
              </select>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-100 dark:border-gray-800">
          <button type="submit" class="btn btn-success btn-lg flex-1 sm:flex-none">
            <span class="material-icons-round mi-sm">add_circle</span>Create Order
          </button>
          <a href="/admin/orders" class="btn btn-outline btn-lg flex-1 sm:flex-none text-center">Cancel</a>
        </div>
      </form>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
