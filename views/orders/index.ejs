<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('../partials/nav-admin') %>

  <div class="max-w-7xl mx-auto px-4 py-6 sm:py-8">
    <%- include('../partials/flash') %>

    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-6">
      <div class="flex items-center gap-3">
        <span class="material-icons-round text-primary-500 mi-xl">receipt_long</span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-800 dark:text-white">Orders</h1>
      </div>
      <div class="flex flex-wrap gap-2 w-full sm:w-auto">
        <a href="/admin/orders/pending-approvals" class="btn btn-accent btn-sm">
          <span class="material-icons-round mi-sm">pending_actions</span>Approvals
        </a>
        <a href="/admin/orders/bulk-assign" class="btn btn-outline btn-sm">
          <span class="material-icons-round mi-sm">assignment_ind</span>Bulk Assign
        </a>
        <a href="/admin/orders/new" class="btn btn-success btn-sm sm:btn-md">
          <span class="material-icons-round mi-sm">add_circle</span>Create Order
        </a>
      </div>
    </div>

    <!-- Status Filter Tabs -->
    <div class="card mb-6 p-2 sm:p-3 overflow-x-auto">
      <div class="flex gap-1 sm:gap-2 flex-nowrap">
        <a href="/admin/orders?status=all" class="px-3 sm:px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap transition <%= currentStatus === 'all' ? 'bg-primary-500 text-white shadow' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800' %>">All</a>
        <a href="/admin/orders?status=Order%20Placed" class="px-3 sm:px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap transition <%= currentStatus === 'Order Placed' ? 'bg-gray-500 text-white shadow' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800' %>">Placed</a>
        <a href="/admin/orders?status=Cutting" class="px-3 sm:px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap transition <%= currentStatus === 'Cutting' ? 'bg-amber-500 text-white shadow' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800' %>">Cutting</a>
        <a href="/admin/orders?status=In%20Stitching" class="px-3 sm:px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap transition <%= currentStatus === 'In Stitching' ? 'bg-primary-500 text-white shadow' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800' %>">Stitching</a>
        <a href="/admin/orders?status=Final%20Touches" class="px-3 sm:px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap transition <%= currentStatus === 'Final Touches' ? 'bg-accent-500 text-white shadow' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800' %>">Final</a>
        <a href="/admin/orders?status=Ready%20for%20Pickup" class="px-3 sm:px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap transition <%= currentStatus === 'Ready for Pickup' ? 'bg-success-500 text-white shadow' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800' %>">Ready</a>
      </div>
    </div>

    <!-- Desktop Table -->
    <div class="hidden sm:block card p-0 overflow-hidden">
      <table class="data-table">
        <thead>
          <tr>
            <th class="pl-6">Order #</th>
            <th>Customer</th>
            <th>Garment</th>
            <th>Status</th>
            <th>Price</th>
            <th>Due Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (orders && orders.length > 0) { %>
            <% orders.forEach((order) => { %>
              <tr>
                <td class="pl-6 font-mono font-bold"><%= order.orderNumber %></td>
                <td>
                  <% if (order.customer) { %>
                    <a href="/admin/customers/<%= order.customer._id %>" class="text-primary-500 hover:text-primary-600 font-medium"><%= order.customer.name %></a>
                  <% } else { %>
                    <span class="text-gray-400">N/A</span>
                  <% } %>
                </td>
                <td><%= order.garmentType %></td>
                <td>
                  <span class="badge
                    <%= order.status === 'Order Placed' ? 'badge-placed' : '' %>
                    <%= order.status === 'Cutting' ? 'badge-cutting' : '' %>
                    <%= order.status === 'In Stitching' ? 'badge-stitching' : '' %>
                    <%= order.status === 'Final Touches' ? 'badge-touches' : '' %>
                    <%= order.status === 'Ready for Pickup' ? 'badge-ready' : '' %>
                  "><%= order.status %></span>
                </td>
                <td class="font-semibold">&#8377;<%= order.price %></td>
                <td class="text-sm"><%= order.dueDate ? new Date(order.dueDate).toLocaleDateString() : '-' %></td>
                <td>
                  <div class="flex items-center gap-1">
                    <a href="/admin/orders/<%= order._id %>" class="btn btn-ghost btn-sm"><span class="material-icons-round mi-sm">visibility</span></a>
                    <a href="/admin/orders/<%= order._id %>/edit" class="btn btn-ghost btn-sm" style="color:#FFA726;"><span class="material-icons-round mi-sm">edit</span></a>
                    <% const statuses = ['Order Placed', 'Cutting', 'In Stitching', 'Final Touches', 'Ready for Pickup'];
                       const currentIdx = statuses.indexOf(order.status);
                       const nextStatus = currentIdx < statuses.length - 1 ? statuses[currentIdx + 1] : null;
                    %>
                    <% if (nextStatus) { %>
                      <button onclick="quickUpdateStatus('<%= order._id %>', '<%= nextStatus %>')" class="btn btn-ghost btn-sm" style="color:#388E3C;" title="Move to <%= nextStatus %>"><span class="material-icons-round mi-sm">skip_next</span></button>
                    <% } %>
                    <form action="/admin/orders/<%= order._id %>?_method=DELETE" method="POST" style="display:inline;" onsubmit="return confirm('Delete this order?');">
                      <button type="submit" class="btn btn-ghost btn-sm" style="color:#D32F2F;"><span class="material-icons-round mi-sm">delete</span></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="7" class="text-center py-10">
              <span class="material-icons-round text-gray-300 dark:text-gray-600" style="font-size:48px;">receipt_long</span>
              <p class="text-gray-400 mt-2 text-sm">No orders found.</p>
              <a href="/admin/orders/new" class="btn btn-success btn-sm mt-3">Create Order</a>
            </td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Mobile Cards -->
    <div class="sm:hidden space-y-3">
      <% if (orders && orders.length > 0) { %>
        <% orders.forEach((order) => { %>
          <div class="card">
            <div class="flex justify-between items-start gap-2 mb-3">
              <div>
                <p class="font-mono font-bold text-gray-800 dark:text-white">#<%= order.orderNumber %></p>
                <% if (order.customer) { %>
                  <p class="text-xs text-primary-500"><%= order.customer.name %></p>
                <% } %>
              </div>
              <span class="badge
                <%= order.status === 'Order Placed' ? 'badge-placed' : '' %>
                <%= order.status === 'Cutting' ? 'badge-cutting' : '' %>
                <%= order.status === 'In Stitching' ? 'badge-stitching' : '' %>
                <%= order.status === 'Final Touches' ? 'badge-touches' : '' %>
                <%= order.status === 'Ready for Pickup' ? 'badge-ready' : '' %>
              "><%= order.status %></span>
            </div>
            <div class="grid grid-cols-3 gap-2 text-xs mb-3">
              <div><p class="text-gray-400 uppercase">Garment</p><p class="font-semibold text-gray-700 dark:text-gray-300"><%= order.garmentType %></p></div>
              <div><p class="text-gray-400 uppercase">Price</p><p class="font-bold text-gray-700 dark:text-gray-300">&#8377;<%= order.price %></p></div>
              <div><p class="text-gray-400 uppercase">Due</p><p class="font-semibold text-gray-700 dark:text-gray-300"><%= order.dueDate ? new Date(order.dueDate).toLocaleDateString() : '-' %></p></div>
            </div>
            <div class="flex gap-2">
              <a href="/admin/orders/<%= order._id %>" class="btn btn-primary btn-sm flex-1">View</a>
              <a href="/admin/orders/<%= order._id %>/edit" class="btn btn-accent btn-sm flex-1">Edit</a>
              <% const mStatuses = ['Order Placed', 'Cutting', 'In Stitching', 'Final Touches', 'Ready for Pickup'];
                 const mIdx = mStatuses.indexOf(order.status);
                 const mNext = mIdx < mStatuses.length - 1 ? mStatuses[mIdx + 1] : null;
              %>
              <% if (mNext) { %>
                <button onclick="quickUpdateStatus('<%= order._id %>', '<%= mNext %>')" class="btn btn-success btn-sm flex-1">Next</button>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="card text-center py-8">
          <span class="material-icons-round text-gray-300 dark:text-gray-600" style="font-size:48px;">receipt_long</span>
          <p class="text-gray-400 mt-2 text-sm">No orders found.</p>
          <a href="/admin/orders/new" class="btn btn-success btn-sm mt-3">Create Order</a>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('../partials/footer') %>
  <script src="/js/order-status.js"></script>
  <script>
    async function quickUpdateStatus(orderId, newStatus) {
      if (confirm('Move order to "' + newStatus + '"?')) {
        const response = await fetch('/admin/orders/' + orderId + '/status', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus }),
        });
        if (response.ok) { location.reload(); }
        else { alert('Failed to update status'); }
      }
    }
  </script>
</body>
</html>
