<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('../partials/nav-admin') %>

  <div class="max-w-4xl mx-auto px-4 py-6 sm:py-8">
    <%- include('../partials/flash') %>

    <a href="/admin/orders/<%= order._id %>" class="btn btn-ghost btn-sm mb-4">
      <span class="material-icons-round mi-sm">arrow_back</span>Back to Order
    </a>

    <div class="flex items-center gap-3 mb-6">
      <span class="material-icons-round text-accent-500 mi-xl">edit</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-800 dark:text-white">Edit Order #<%= order.orderNumber %></h1>
    </div>

    <div class="card">
      <form action="/admin/orders/<%= order._id %>?_method=PUT" method="POST" class="space-y-6">
        <div>
          <label class="form-label">Customer</label>
          <div class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg px-4 py-3 flex items-center gap-2">
            <span class="material-icons-round mi-sm text-primary-500">person</span>
            <span class="font-semibold text-gray-800 dark:text-white"><%= order.customer ? order.customer.name : 'N/A' %></span>
            <% if (order.customer) { %><span class="text-sm text-gray-500">(<%= order.customer.phone %>)</span><% } %>
          </div>
          <input type="hidden" name="customer" value="<%= order.customer ? order.customer._id : '' %>" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="form-label">Garment Type</label>
            <select name="garmentType" class="form-input">
              <option value="Suit" <%= order.garmentType === 'Suit' ? 'selected' : '' %>>Suit</option>
              <option value="Shirt" <%= order.garmentType === 'Shirt' ? 'selected' : '' %>>Shirt</option>
              <option value="Kurta" <%= order.garmentType === 'Kurta' ? 'selected' : '' %>>Kurta</option>
              <option value="Other" <%= order.garmentType === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>
          <div>
            <label class="form-label">Status</label>
            <select name="status" class="form-input">
              <% statuses.forEach((status) => { %>
                <option value="<%= status %>" <%= order.status === status ? 'selected' : '' %>><%= status %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div>
          <label class="form-label">Description</label>
          <textarea name="description" rows="3" class="form-input"><%= order.description %></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="form-label">Price (&#8377;)</label>
            <input type="number" name="price" value="<%= order.price %>" step="0.01" min="0" class="form-input" />
          </div>
          <div>
            <label class="form-label">Advance Paid (&#8377;)</label>
            <input type="number" name="advancePaid" value="<%= order.advancePaid %>" step="0.01" min="0" class="form-input" />
          </div>
        </div>

        <div>
          <label class="form-label">Due Date</label>
          <input type="date" name="dueDate" value="<%= order.dueDate ? order.dueDate.toISOString().split('T')[0] : '' %>" class="form-input" />
        </div>

        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4">
          <div class="grid grid-cols-3 gap-4 text-sm">
            <div><p class="text-xs text-gray-400 uppercase">Order #</p><p class="font-mono font-bold text-gray-700 dark:text-gray-300"><%= order.orderNumber %></p></div>
            <div><p class="text-xs text-gray-400 uppercase">Created</p><p class="font-semibold text-gray-700 dark:text-gray-300"><%= new Date(order.createdAt).toLocaleDateString() %></p></div>
            <div><p class="text-xs text-gray-400 uppercase">Progress</p><p class="font-semibold text-gray-700 dark:text-gray-300"><%= order.statusIndex + 1 %>/5</p></div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-100 dark:border-gray-800">
          <button type="submit" class="btn btn-primary btn-lg flex-1 sm:flex-none">
            <span class="material-icons-round mi-sm">save</span>Update Order
          </button>
          <a href="/admin/orders/<%= order._id %>" class="btn btn-outline btn-lg flex-1 sm:flex-none text-center">Cancel</a>
        </div>
      </form>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
