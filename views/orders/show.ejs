<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body class="bg-gray-50 dark:bg-gray-950 min-h-screen">
  <%- include('../partials/nav-admin') %>

  <div class="max-w-5xl mx-auto px-4 py-6 sm:py-8">
    <%- include('../partials/flash') %>

    <a href="/admin/orders" class="btn btn-ghost btn-sm mb-4">
      <span class="material-icons-round mi-sm">arrow_back</span>Back to Orders
    </a>

    <!-- Order Header -->
    <div class="card mb-6">
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4 mb-6">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 bg-primary-50 dark:bg-primary-500/10 rounded-2xl flex items-center justify-center">
            <span class="material-icons-round text-primary-500" style="font-size:28px;">receipt_long</span>
          </div>
          <div>
            <h1 class="text-2xl font-extrabold text-gray-800 dark:text-white">Order #<%= order.orderNumber %></h1>
            <% if (order.customer) { %>
              <a href="/admin/customers/<%= order.customer._id %>" class="text-sm text-primary-500 hover:text-primary-600 font-medium">
                <span class="material-icons-round mi-sm align-middle">person</span> <%= order.customer.name %> (<%= order.customer.phone %>)
              </a>
            <% } %>
          </div>
        </div>
        <div class="flex gap-2 w-full sm:w-auto">
          <a href="/admin/orders/<%= order._id %>/edit" class="btn btn-accent flex-1 sm:flex-none"><span class="material-icons-round mi-sm">edit</span>Edit</a>
          <form action="/admin/orders/<%= order._id %>?_method=DELETE" method="POST" style="display:flex;flex:1;" onsubmit="return confirm('Delete this order?');">
            <button type="submit" class="btn btn-danger flex-1"><span class="material-icons-round mi-sm">delete</span>Delete</button>
          </form>
        </div>
      </div>

      <!-- Status Stepper -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-bold text-gray-800 dark:text-white flex items-center gap-2">
            <span class="material-icons-round mi-sm text-primary-500">timeline</span>Order Progress
          </h3>
          <button type="button" onclick="openStatusModal()" class="btn btn-primary btn-sm">
            <span class="material-icons-round mi-sm">bolt</span>Update Status
          </button>
        </div>
        <%
          let statuses = ['Order Placed', 'Cutting', 'In Stitching', 'Final Touches', 'Ready for Pickup'];
          const currentIndex = statuses.indexOf(order.status);
        %>
        <div class="stepper">
          <% statuses.forEach((step, i) => { %>
            <div class="step <%= i < currentIndex ? 'completed' : '' %> <%= i === currentIndex ? 'active' : '' %>">
              <div class="step-circle">
                <% if (i < currentIndex) { %>
                  <span class="material-icons-round" style="font-size:16px;">check</span>
                <% } else { %>
                  <%= i + 1 %>
                <% } %>
              </div>
              <div class="step-label"><%= step %></div>
              <% if (i < statuses.length - 1) { %>
                <div class="step-line"></div>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Order Details Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4">
          <p class="text-xs text-gray-400 uppercase font-medium mb-1">Garment</p>
          <p class="font-bold text-gray-800 dark:text-white"><%= order.garmentType %></p>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4">
          <p class="text-xs text-gray-400 uppercase font-medium mb-1">Status</p>
          <span class="badge
            <%= order.status === 'Order Placed' ? 'badge-placed' : '' %>
            <%= order.status === 'Cutting' ? 'badge-cutting' : '' %>
            <%= order.status === 'In Stitching' ? 'badge-stitching' : '' %>
            <%= order.status === 'Final Touches' ? 'badge-touches' : '' %>
            <%= order.status === 'Ready for Pickup' ? 'badge-ready' : '' %>
          " id="statusBadge"><%= order.status %></span>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4">
          <p class="text-xs text-gray-400 uppercase font-medium mb-1">Created</p>
          <p class="font-bold text-gray-800 dark:text-white"><%= new Date(order.createdAt).toLocaleDateString() %></p>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4">
          <p class="text-xs text-gray-400 uppercase font-medium mb-1">Due Date</p>
          <p class="font-bold text-gray-800 dark:text-white"><%= order.dueDate ? new Date(order.dueDate).toLocaleDateString() : 'Not set' %></p>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4">
          <p class="text-xs text-gray-400 uppercase font-medium mb-1">Total Price</p>
          <p class="font-bold text-primary-500 text-lg">&#8377;<%= order.price %></p>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4">
          <p class="text-xs text-gray-400 uppercase font-medium mb-1">Advance Paid</p>
          <p class="font-bold text-success-600 text-lg">&#8377;<%= order.advancePaid %></p>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4">
          <p class="text-xs text-gray-400 uppercase font-medium mb-1">Balance Due</p>
          <p class="font-bold text-lg <%= (order.price - order.advancePaid) === 0 ? 'text-success-600' : 'text-danger-500' %>">&#8377;<%= order.price - order.advancePaid %></p>
        </div>
        <% if (order.assignedCuttingMaster) { %>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4">
          <p class="text-xs text-gray-400 uppercase font-medium mb-1">Cutting Master</p>
          <p class="font-bold text-gray-800 dark:text-white"><%= order.assignedCuttingMaster.name || order.assignedCuttingMaster.username %></p>
        </div>
        <% } %>
        <% if (order.assignedTailor) { %>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4">
          <p class="text-xs text-gray-400 uppercase font-medium mb-1">Assigned Tailor</p>
          <p class="font-bold text-gray-800 dark:text-white"><%= order.assignedTailor.name || order.assignedTailor.username %></p>
        </div>
        <% } %>
        <% if (order.cuttingStatus) { %>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4">
          <p class="text-xs text-gray-400 uppercase font-medium mb-1">Cutting Status</p>
          <span class="badge <%= order.cuttingStatus === 'Done' ? 'badge-ready' : 'badge-cutting' %>"><%= order.cuttingStatus %></span>
        </div>
        <% } %>
      </div>

      <% if (order.description) { %>
        <div class="mt-5 bg-primary-50 dark:bg-primary-500/5 border border-primary-100 dark:border-primary-500/10 rounded-lg p-4">
          <h4 class="font-bold text-gray-800 dark:text-white mb-2 flex items-center gap-2">
            <span class="material-icons-round mi-sm text-primary-500">description</span>Description
          </h4>
          <p class="text-sm text-gray-600 dark:text-gray-400 whitespace-pre-wrap"><%= order.description %></p>
        </div>
      <% } %>

      <% if (order.readyPhotoUrl) { %>
        <div class="mt-5">
          <h4 class="font-bold text-gray-800 dark:text-white mb-2 flex items-center gap-2">
            <span class="material-icons-round mi-sm text-success-600">photo_camera</span>Ready Photo
          </h4>
          <img src="<%= order.readyPhotoUrl %>" alt="Ready photo" class="rounded-lg max-h-64 object-cover border border-gray-200 dark:border-gray-700" />
        </div>
      <% } %>
    </div>
  </div>

  <input type="hidden" id="orderId" value="<%= order._id %>" />

  <!-- Status Update Modal -->
  <div id="statusModal" class="modal-overlay">
    <div class="modal-content">
      <h2 class="text-xl font-bold text-gray-800 dark:text-white mb-2">Update Order Status</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-5">Current: <span class="font-semibold"><%= order.status %></span></p>
      <div class="space-y-2 mb-5">
        <% statuses.forEach((status, index) => { %>
          <button type="button" onclick="handleStatusSelect('<%= status %>')"
            class="w-full px-4 py-3 rounded-lg border-2 text-left font-semibold text-sm transition-all flex items-center gap-3
              <%= status === order.status ? 'bg-primary-500 text-white border-primary-500' : 'border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:border-primary-500' %>">
            <span class="material-icons-round mi-sm">
              <% if (index < currentIndex) { %>check_circle<% } else if (status === order.status) { %>radio_button_checked<% } else { %>radio_button_unchecked<% } %>
            </span>
            <%= status %>
          </button>
        <% }); %>
      </div>
      <button type="button" onclick="closeStatusModal()" class="btn btn-outline btn-block">Cancel</button>
    </div>
  </div>

  <%- include('../partials/footer') %>
  <script src="/js/order-status.js"></script>
  <script>
    function openStatusModal() { document.getElementById('statusModal').classList.add('active'); }
    function closeStatusModal() { document.getElementById('statusModal').classList.remove('active'); }
  </script>
</body>
</html>
